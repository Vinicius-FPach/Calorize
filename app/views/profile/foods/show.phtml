                <?php
                    // Distribuição calórica dos macros (proteína/carbo ~4 kcal/g, gordura ~9 kcal/g)
                    $proteinKcal = $food->protein * 4;
                    $carbsKcal   = $food->carbs * 4;
                    $fatsKcal    = $food->fats * 9;
                    $macroKcalTotal = $proteinKcal + $carbsKcal + $fatsKcal;

                    $proteinPct = $macroKcalTotal > 0 ? round($proteinKcal / $macroKcalTotal * 100) : 0;
                    $carbsPct   = $macroKcalTotal > 0 ? round($carbsKcal / $macroKcalTotal * 100) : 0;
                    $fatsPct    = $macroKcalTotal > 0 ? max(0, 100 - $proteinPct - $carbsPct) : 0;
                ?>

                <?php if ($macroKcalTotal > 0) : ?>
                    <div class="mb-6">
                        <div class="w-full h-2 rounded-full overflow-hidden flex bg-gray-100">
                            <div class="h-full bg-primary" style="width: <?= $proteinPct ?>%"></div>
                            <div class="h-full bg-primary/55" style="width: <?= $carbsPct ?>%"></div>
                            <div class="h-full bg-primary/25" style="width: <?= $fatsPct ?>%"></div>
                        </div>

                        <div class="flex gap-4 mt-2 text-xs text-gray-500">
