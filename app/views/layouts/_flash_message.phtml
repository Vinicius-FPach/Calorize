<?php
$colors = [
    'success' => 'bg-green-100 border-green-400 text-green-700',
    'danger'  => 'bg-red-100 border-red-600 text-red-700',
    'warning' => 'bg-yellow-100 border-yellow-400 text-yellow-700',
    'info'    => 'bg-blue-100 border-blue-400 text-blue-700',
];
?>

<?php foreach (\Lib\FlashMessage::get() as $type => $msg) : 
    $class = $colors[$type] ?? 'bg-gray-100 border-gray-400 text-gray-700';
?>
    <div class="flex items-center justify-between p-4 mb-4 border rounded-lg <?= $class ?>" role="alert">
        <div class="text-sm font-medium">
            <?= $msg ?>
        </div>
        <button type="button" 
                onclick="this.parentElement.remove();" 
                class="ml-auto -mx-1.5 -my-1.5 rounded-lg p-1.5 inline-flex items-center justify-center h-8 w-8 hover:bg-opacity-20 focus:outline-none cursor-pointer" 
                aria-label="Close">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
<?php endforeach ?>